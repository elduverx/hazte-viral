# Copia este archivo como .env y rellena los valores. .env nunca se sube a git.
# Puede ser la misma API key de Anthropic que usa tipsoncontractor
ANTHROPIC_API_KEY=sk-ant-...
# Token compartido con la app (genera uno con: openssl rand -hex 32). Debe coincidir con appToken en AIService.swift
APP_TOKEN=CAMBIA_ESTO
PORT=3200
# En el VPS: HOST=172.17.0.1 (para que Caddy en Docker llegue al backend)
HOST=127.0.0.1
RATE_LIMIT_PER_HOUR=30
# Correo de contacto que aparece en /privacy
CONTACT_EMAIL=contacto@ejemplo.com
